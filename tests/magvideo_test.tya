import magvideo
import unittest
import file as file

class MagvideoTest extends TestCase
  test_settings_defaults_and_save = ->
    settings = Settings.defaults()
    self.assert_equal("mp4", settings["output_format"], "default mp4")
    self.assert_equal("local_file", settings["clipboard_mode"], "clipboard")
    Settings.save(settings)
    self.assert(file.File.exists?(Settings.path()), "settings file")

  test_devices_and_recording_lifecycle = ->
    settings = Settings.defaults()
    recorder = Recorder.new(settings)
    self.assert(recorder.cameras().len() > 0, "cameras")
    self.assert(recorder.microphones().len() > 0, "microphones")
    recorder.start()
    self.assert(recorder.recording, "recording")
    path = recorder.stop()
    self.assert(file.File.exists?(path), "output file")
    result = Upload.after_recording(path, settings)
    copied = Clipboard.copy_result(result, settings)
    self.assert(copied["text"] != "", "clipboard fallback")

  test_upload_modes = ->
    settings = Settings.defaults()
    settings["clipboard_mode"] = "s3"
    settings["upload_destination"] = "https://example.com"
    result = Upload.after_recording("/tmp/magvideo-test.mp4", settings)
    self.assert(result["ok"], "upload result")
    self.assert(result["url"].starts_with("https://example.com/"), "url")
