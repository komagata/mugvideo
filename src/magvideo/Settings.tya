import file as file
import toml as toml

class Settings
  static defaults = ->
    settings = {}
    settings["quality"] = "standard"
    settings["fps"] = 30
    settings["max_duration_seconds"] = 60
    settings["output_format"] = "mp4"
    settings["clipboard_mode"] = "local_file"
    settings["upload_destination"] = ""
    settings["output_dir"] = magvideo_output_dir_native()
    return settings

  static path = ->
    return magvideo_config_dir_native() + "/settings.toml"

  static load = ->
    path = Settings.path()
    settings = Settings.defaults()
    if file.File.exists?(path)
      parsed = toml.Toml.parse(file.File.read(path))
      for key in parsed.keys()
        settings[key] = parsed[key]
    return settings

  static save = settings ->
    text = "quality = \"" + settings["quality"] + "\"\n"
    text = text + "fps = " + settings["fps"].to_s() + "\n"
    text = text + "max_duration_seconds = " + settings["max_duration_seconds"].to_s() + "\n"
    text = text + "output_format = \"" + settings["output_format"] + "\"\n"
    text = text + "clipboard_mode = \"" + settings["clipboard_mode"] + "\"\n"
    text = text + "upload_destination = \"" + settings["upload_destination"] + "\"\n"
    text = text + "output_dir = \"" + settings["output_dir"] + "\"\n"
    file.File.write(Settings.path(), text)
    return settings

  static content_type = settings ->
    if settings["output_format"] == "webm"
      return "video/webm"
    return "video/mp4"

  static extension = settings ->
    if settings["output_format"] == "webm"
      return ".webm"
    return ".mp4"
